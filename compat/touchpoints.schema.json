{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin compatibility touchpoints v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "touchpoints"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "touchpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product",
          "uses",
          "anchors",
          "code",
          "impact",
          "milestones",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "product": {
            "enum": [
              "bb",
              "SDK",
              "ZCode"
            ]
          },
          "uses": {
            "type": "string",
            "minLength": 1
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "text",
                "strength",
                "reason"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "alternativeFiles": {
                  "description": "Other observed locations for this same semantic anchor; any one location must contain text.",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "strength": {
                  "enum": [
                    "strong",
                    "weak"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "code": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "milestones": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
